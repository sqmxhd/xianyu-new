# The tg branch publishes this moving deployment tag.
XIANYU_IMAGE=192.168.2.5:5050/bug/xianyu:latest

# Start the bundled MySQL and Redis services. Remove this value when using
# externally managed infrastructure.
COMPOSE_PROFILES=bundled

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_PASSWORD=replace-with-a-strong-app-password
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Keep these URLs aligned with the passwords above. URL-encode special
# characters used in a password.
XIANYU_DATABASE_URL=mysql+pymysql://xianyu:replace-with-a-strong-app-password@mysql:3306/xianyu_admin?charset=utf8mb4
XIANYU_REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0
XIANYU_JWT_SECRET=replace-with-at-least-32-random-characters
XIANYU_JWT_EXPIRES_MINUTES=10080

# Runtime scheduling and concurrency. Keep the defaults unless the host has
# been capacity-tested with different values.
XIANYU_COOKIE_RENEWAL_ENABLED=true
XIANYU_COOKIE_RENEWAL_INTERVAL_HOURS=1
XIANYU_COOKIE_KEEPALIVE_INTERVAL_SECONDS=600
XIANYU_COOKIE_KEEPALIVE_RECHECK_MIN_SECONDS=15
XIANYU_COOKIE_KEEPALIVE_RECHECK_MAX_SECONDS=30
XIANYU_COOKIE_RENEWAL_SCAN_SECONDS=60
XIANYU_COOKIE_RENEWAL_MANUAL_COOLDOWN_SECONDS=3600
XIANYU_CONVERSATION_SYNC_INTERVAL_SECONDS=180
XIANYU_CHATWOOT_RECONCILE_INTERVAL_SECONDS=900
XIANYU_CHATWOOT_READ_SYNC_INTERVAL_SECONDS=20
XIANYU_CONVERSATION_FULL_SYNC_MAX_PAGES=50
XIANYU_QR_LOGIN_WORKERS=2
XIANYU_QR_LOGIN_MAX_ACTIVE_SESSIONS=4
XIANYU_RUNTIME_START_CONCURRENCY=3
XIANYU_RUNTIME_START_JITTER_SECONDS=3
XIANYU_CONVERSATION_SYNC_CONCURRENCY=3
XIANYU_COOKIE_RENEWAL_CONCURRENCY=2
XIANYU_WORKER_CONCURRENCY=4
XIANYU_WORKER_LEASE_SECONDS=120
XIANYU_WORKER_LEASE_RENEW_SECONDS=30
XIANYU_IM_VERIFICATION_SESSION_SECONDS=600
XIANYU_ACCOUNT_BROWSER_IDLE_SECONDS=1800
XIANYU_ACCOUNT_BROWSER_MAX_SESSION_SECONDS=28800
XIANYU_ACCOUNT_BROWSER_MAX_SESSIONS=3

# The gateway is same-origin by default, so CORS can remain empty. Set an
# explicit comma-separated list only when a separate frontend calls the API.
XIANYU_CORS_ORIGINS=
# Set the externally reachable HTTPS origin when Chatwoot or another external
# webhook consumer is enabled, for example https://xianyu.example.internal:6161.
XIANYU_PUBLIC_BASE_URL=
XIANYU_BIND_IP=0.0.0.0
XIANYU_HTTPS_PORT=6161
XIANYU_TLS_DIR=/etc/xianyu/tls
XIANYU_INTERNAL_CA_FILE=/usr/local/share/ca-certificates/xianyu-internal-root-B8868920.crt
