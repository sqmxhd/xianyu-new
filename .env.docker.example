XIANYU_IMAGE=192.168.2.5:5050/bug/xianyu:latest
XIANYU_VERSION=latest
XIANYU_COMMIT=

# Start the bundled MySQL and Redis services. Remove this value when using
# externally managed infrastructure.
COMPOSE_PROFILES=bundled

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_PASSWORD=replace-with-a-strong-app-password
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Keep these URLs aligned with the passwords above. URL-encode special
# characters used in a password.
XIANYU_DATABASE_URL=mysql+pymysql://xianyu:replace-with-a-strong-app-password@mysql:3306/xianyu_admin?charset=utf8mb4
XIANYU_REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0
XIANYU_JWT_SECRET=replace-with-at-least-32-random-characters

# The gateway is same-origin by default, so CORS can remain empty. Set an
# explicit comma-separated list only when a separate frontend calls the API.
XIANYU_CORS_ORIGINS=
# Set the externally reachable HTTPS origin when Chatwoot or another external
# webhook consumer is enabled, for example https://xianyu.example.internal:6161.
XIANYU_PUBLIC_BASE_URL=
XIANYU_BIND_IP=0.0.0.0
XIANYU_HTTPS_PORT=6161
XIANYU_TLS_DIR=/etc/xianyu/tls
XIANYU_INTERNAL_CA_FILE=/usr/local/share/ca-certificates/xianyu-internal-root-B8868920.crt

# CI passes the GitLab Dependency Proxy prefix to Docker builds. For an
# authenticated local build, set the same prefix here; otherwise leave the
# public default.
BASE_IMAGE_PREFIX=docker.io/library
