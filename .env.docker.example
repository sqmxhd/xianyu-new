# ============================================================
# 闲鱼管理平台：Docker 项目容器模式
#
# 使用场景：只启动一个闲鱼应用容器，连接外部 PostgreSQL、Redis。
# 复制命令：cp .env.docker.example .env.docker
# 只有没有“#”的两项主配置需要填写。
# JWT 在首次启动时自动生成并保存到 Docker 持久化卷。
# ============================================================

# 【主配置｜必须填写】
# 外部 PostgreSQL 完整连接地址。
XIANYU_DATABASE_URL=

# 【主配置｜必须填写】
# 外部 Redis 完整连接地址。
XIANYU_REDIS_URL=

# 【系统自动生成｜不要取消注释】
# 首次启动自动生成；后续重启和镜像升级继续使用原值。
# XIANYU_JWT_SECRET=

# 【条件主配置｜通常在管理后台配置】
# Chatwoot 或外部 Webhook 需要固定绝对回调地址时才设置。
# XIANYU_PUBLIC_BASE_URL=https://xianyu.example.com:6161

# 【次配置｜默认拉取 main 分支发布的 latest】
# 只有需要固定版本或使用离线导入标签时才修改。
# XIANYU_IMAGE=192.168.2.5:5050/bug/xianyu:latest

# 【次配置｜默认监听全部 IPv4 网卡】
# XIANYU_BIND_IP=0.0.0.0

# 【次配置｜默认 HTTPS 端口 6161】
# XIANYU_HTTPS_PORT=6161

# 【次配置｜同源模式无需修改】
# XIANYU_CORS_ORIGINS=

# 【次配置｜访问令牌默认 24 小时】
# 管理员短期访问令牌有效期（分钟）；系统会通过长期会话自动续期。
# XIANYU_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# 【次配置｜登录会话默认一年并滑动续期】
# 管理员长期登录会话有效期（天）；每次成功续期后重新顺延。
# XIANYU_ADMIN_SESSION_EXPIRES_DAYS=365

# 高级运行参数见 docs/configuration.md。
# 不要在没有容量测试或故障依据时修改并发、同步周期和超时参数。
