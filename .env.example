# Copy this file to .env.local and replace every placeholder.
XIANYU_DATABASE_URL=mysql+pymysql://xianyu_user:replace-me@127.0.0.1:3306/xianyu_admin?charset=utf8mb4
XIANYU_REDIS_URL=redis://:replace-me@127.0.0.1:6379/0

# API and frontend use same-origin /api through Vite or Nginx.
XIANYU_API_HEALTH_URL=http://127.0.0.1:8000/api/health
XIANYU_INTERNAL_API_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=
XIANYU_CORS_ORIGINS=http://localhost:9000,http://127.0.0.1:9000

# Comma-separated immediate reverse proxies whose forwarding headers may be trusted.
XIANYU_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Generate a random value of at least 32 characters.
XIANYU_JWT_SECRET=replace-with-a-long-random-jwt-secret
XIANYU_JWT_EXPIRES_MINUTES=10080

# Pure HTTP Cookie renewal. No browser or Playwright is used.
XIANYU_COOKIE_RENEWAL_ENABLED=true
XIANYU_COOKIE_RENEWAL_INTERVAL_HOURS=1
XIANYU_COOKIE_KEEPALIVE_INTERVAL_SECONDS=600
XIANYU_COOKIE_RENEWAL_SCAN_SECONDS=60
# Prevent repeated successful manual renewals from hammering the platform API.
XIANYU_COOKIE_RENEWAL_MANUAL_COOLDOWN_SECONDS=3600
# Optional comma-separated probes. Built-in IPv4/IPv6 probes remain enabled.
XIANYU_PROXY_IP_CHECK_URLS=
# XIANYU_IP2REGION_DB_PATH=/absolute/path/to/ip2region_v4.xdb
# XIANYU_GEOIP_DB_PATH=/absolute/path/to/geoip.db
XIANYU_CONVERSATION_SYNC_INTERVAL_SECONDS=180
XIANYU_CONVERSATION_FULL_SYNC_MAX_PAGES=50
# Blocking QR requests use a dedicated bounded pool and cannot consume DB workers.
XIANYU_QR_LOGIN_WORKERS=2
XIANYU_QR_LOGIN_MAX_ACTIVE_SESSIONS=4

# Single-process blocking work is isolated by domain. Values are global for
# the process and are not multiplied by the number of accounts.
XIANYU_DB_BLOCKING_WORKERS=6
XIANYU_DB_BLOCKING_QUEUE=64
XIANYU_PLATFORM_BLOCKING_WORKERS=8
XIANYU_PLATFORM_BLOCKING_QUEUE=40
XIANYU_MEDIA_BLOCKING_WORKERS=3
XIANYU_MEDIA_BLOCKING_QUEUE=12
XIANYU_EXTERNAL_BLOCKING_WORKERS=4
XIANYU_EXTERNAL_BLOCKING_QUEUE=20
XIANYU_BROWSER_BLOCKING_WORKERS=2
XIANYU_BROWSER_BLOCKING_QUEUE=8

# Account-level work remains serialized; these settings cap cross-account work.
XIANYU_RUNTIME_START_CONCURRENCY=3
XIANYU_RUNTIME_START_JITTER_SECONDS=3
XIANYU_CONVERSATION_SYNC_CONCURRENCY=3
XIANYU_COOKIE_RENEWAL_CONCURRENCY=2
XIANYU_WORKER_CONCURRENCY=4
XIANYU_WORKER_LEASE_SECONDS=120
XIANYU_WORKER_LEASE_RENEW_SECONDS=30

# In-process event-loop diagnostics shown on the admin dashboard.
XIANYU_EVENT_LOOP_MONITOR_INTERVAL_SECONDS=1
XIANYU_EVENT_LOOP_LAG_WARNING_SECONDS=0.5

# Single shared visual browser runtime for platform-account access, QR login,
# and manual IM risk verification. Profiles remain isolated per account and
# the VNC listener is bound to loopback only.
XIANYU_IM_VERIFICATION_BROWSER_ENABLED=true
# Leave empty to discover google-chrome/chromium from PATH.
XIANYU_IM_VERIFICATION_BROWSER_PATH=
# Versioned Fingerprint Chromium binaries installed from system settings.
XIANYU_FINGERPRINT_BROWSER_ROOT=/opt/xianyu/third_party/fingerprint-chromium
# Versioned standard Chrome for Testing binaries installed from system settings.
XIANYU_STANDARD_BROWSER_ROOT=/opt/xianyu/third_party/standard-chromium
XIANYU_FINGERPRINT_BROWSER_DOWNLOAD_TIMEOUT_SECONDS=600
XIANYU_FINGERPRINT_BROWSER_MAX_ARCHIVE_BYTES=536870912
XIANYU_FINGERPRINT_BROWSER_MAX_EXTRACTED_BYTES=1073741824
XIANYU_IM_VERIFICATION_PROFILE_DIR=/opt/xianyu/data/browser-profiles
XIANYU_IM_VERIFICATION_DISPLAY=:99
XIANYU_IM_VERIFICATION_VNC_PORT=5901
XIANYU_IM_VERIFICATION_SESSION_SECONDS=600
# Account VNC sessions close after 30 minutes without operator input and always
# stop at the hard eight-hour ceiling. The former
# XIANYU_ACCOUNT_BROWSER_SESSION_SECONDS remains an idle-timeout fallback.
XIANYU_ACCOUNT_BROWSER_IDLE_SECONDS=1800
XIANYU_ACCOUNT_BROWSER_MAX_SESSION_SECONDS=28800
XIANYU_ACCOUNT_BROWSER_MAX_SESSIONS=3
# CDP is intentionally bound by the application to 127.0.0.1 only. Never
# publish this port directly through a firewall, reverse proxy, or container.
XIANYU_ACCOUNT_BROWSER_CDP_ENABLED=true
XIANYU_ACCOUNT_BROWSER_CDP_PORT=9222
# Optional self-hosted STUN endpoint used only as an enhanced WebRTC leak probe.
# Leave empty to avoid contacting a third-party service. Browser HTTP egress is
# still checked against the account proxy and an empty value is not a warning.
XIANYU_BROWSER_FINGERPRINT_PROBE_STUN_URL=
# Reuse a recent proxy-page egress result; refresh older baselines before browser
# fingerprint detection so rotating proxy exits are not compared with stale IPs.
XIANYU_BROWSER_FINGERPRINT_PROXY_EXIT_TTL_SECONDS=600
# Keep false when API runs as a non-root production user. Root-only development
# environments must explicitly opt into Chromium --no-sandbox.
XIANYU_IM_VERIFICATION_ALLOW_NO_SANDBOX=false

# Persistent directory shared by the API and queue worker.
XIANYU_PRODUCT_IMAGE_DIR=/opt/xianyu/data/product-images
