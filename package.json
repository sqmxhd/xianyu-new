{
  "name": "xianyu-dev-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run start:local",
    "dev:hot": "npm run config:init && concurrently -n api,admin -c blue,green \"npm run dev:api\" \"npm run dev:admin\"",
    "dev:api": "dotenv -e .env.local -- .venv/bin/uvicorn apps.api.xianyu_admin_api.main:app --host 0.0.0.0 --port 8000 --reload --no-proxy-headers",
    "dev:admin": "dotenv -e .env.local -- npm --prefix apps/admin run dev",
    "start:api": "dotenv -e .env.local -- .venv/bin/uvicorn apps.api.xianyu_admin_api.main:app --host 0.0.0.0 --port 8000 --no-proxy-headers",
    "start:worker": "npm run worker:queue",
    "preview:admin": "dotenv -e .env.local -- npm --prefix apps/admin run preview",
    "db:ensure": "dotenv -e .env.local -- .venv/bin/python tools/ensure_mysql_database.py",
    "config:init": ".venv/bin/python tools/init_local_env.py",
    "start:local": "npm run config:init && npm run db:ensure && npm run build && concurrently -n api,worker,admin -c blue,yellow,green \"bash tools/supervise_process.sh npm run start:api\" \"bash tools/supervise_process.sh npm run start:worker\" \"bash tools/supervise_process.sh npm run preview:admin\"",
    "service:start": "npm run config:init && bash tools/manage_services.sh start",
    "service:stop": "bash tools/manage_services.sh stop",
    "service:restart": "npm run config:init && bash tools/manage_services.sh restart",
    "service:status": "bash tools/manage_services.sh status",
    "service:deploy": "npm run config:init && npm run db:ensure && npm run build && bash tools/manage_services.sh restart",
    "worker:queue": "dotenv -e .env.local -- .venv/bin/python -m apps.api.xianyu_admin_api.worker",
    "worker:queue:once": "dotenv -e .env.local -- .venv/bin/python -m apps.api.xianyu_admin_api.worker --once",
    "upstream:status": ".venv/bin/python tools/update_xianyu_apis.py",
    "upstream:update": ".venv/bin/python tools/update_xianyu_apis.py --update",
    "git:audit": ".venv/bin/python tools/git_audit.py",
    "build": "dotenv -e .env.local -- npm --prefix apps/admin run build",
    "audit:admin": "npm --prefix apps/admin audit --omit=dev",
    "test": "XIANYU_DATABASE_URL=sqlite:///:memory: XIANYU_REDIS_URL=redis://127.0.0.1:6379/15 XIANYU_JWT_SECRET=test-secret-with-sufficient-length .venv/bin/python -m unittest discover -s tests -v",
    "check:internal": "dotenv -e .env.local -- .venv/bin/python tools/internal_healthcheck.py",
    "deploy:check": "bash ./开始部署.sh --check"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "dotenv-cli": "^8.0.0"
  }
}
