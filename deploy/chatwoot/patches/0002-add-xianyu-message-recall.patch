+  def xianyu_recall
+    state = permitted_params[:recall_state].presence || 'requested'
+    return render_invalid_recall('不支持的撤回状态') unless %w[requested recalled failed].include?(state)
+
+    current = message.content_attributes.to_h['xianyu_recall'].to_h
+    if state == 'requested'
+      return render_invalid_recall('只能撤回公开的客服消息') unless message.outgoing? && !message.private?
+      return render_invalid_recall('该消息已经删除') if message.content_attributes.to_h['deleted']
+      return render_invalid_recall('该消息已经撤回') if current['state'] == 'recalled'
+      return render_invalid_recall('已超过闲鱼两分钟撤回时限') if message.created_at < 2.minutes.ago
+
+      recall = {
+        'state' => 'requested',
+        'request_id' => SecureRandom.uuid,
+        'requested_at' => Time.current.iso8601,
+        'requested_by' => Current.user&.id
+      }
+    else
+      recall = current.merge(
+        'state' => state,
+        "#{state}_at" => Time.current.iso8601
+      )
+      recall['error'] = permitted_params[:recall_error].presence if state == 'failed'
+      recall.delete('error') if state == 'recalled'
+    end
+
+    message.update!(
+      content_attributes: message.content_attributes.to_h.merge(
+        'xianyu_recall' => recall
+      )
+    )
+    @message = message
+    render :update
+  end
+
